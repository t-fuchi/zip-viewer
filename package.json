{
  "name": "zip-viewer",
  "displayName": "Zip Viewer",
  "description": "View and extract ZIP, 7Z, TAR, and various compressed archive files",
  "version": "2.1.0",
  "publisher": "Takeshi-Fuchi",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "customEditors": [
      {
        "viewType": "zipViewer.viewer",
        "displayName": "Zip Viewer",
        "selector": [
          {
            "filenamePattern": "*.zip"
          },
          {
            "filenamePattern": "*.7z"
          },
          {
            "filenamePattern": "*.tar"
          },
          {
            "filenamePattern": "*.tar.gz"
          },
          {
            "filenamePattern": "*.tgz"
          },
          {
            "filenamePattern": "*.tar.xz"
          },
          {
            "filenamePattern": "*.tar.bz2"
          },
          {
            "filenamePattern": "*.tbz2"
          },
          {
            "filenamePattern": "*.tz2"
          },
          {
            "filenamePattern": "*.tar.Z"
          },
          {
            "filenamePattern": "*.taz"
          },
          {
            "filenamePattern": "*.taZ"
          },
          {
            "filenamePattern": "*.tar.lz"
          },
          {
            "filenamePattern": "*.tlz"
          },
          {
            "filenamePattern": "*.tar.lzma"
          },
          {
            "filenamePattern": "*.tar.zst"
          },
          {
            "filenamePattern": "*.tzst"
          }
        ]
      }
    ],
    "configuration": {
      "title": "Zip Viewer",
      "properties": {
        "zipViewer.previewLineCount": {
          "type": "number",
          "default": 20,
          "minimum": 1,
          "maximum": 1000,
          "description": "Number of lines to display in file preview"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/tar": "^6.1.5",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.0.0",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "@mongodb-js/zstd": "^7.0.0",
    "7zip-bin": "^5.2.0",
    "lzma-native": "^8.0.6",
    "node-7z": "^3.0.0",
    "tar": "^6.1.15",
    "unbzip2-stream": "^1.4.3",
    "unzipper": "^0.10.14"
  },
  "repository": {
    "type": "git",
    "url": ""
  },
  "license": "UNLICENSED",
  "private": true
}
