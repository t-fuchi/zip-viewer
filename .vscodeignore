node_modules/**/*.map

# TypeScript定義（実行には不要）
node_modules/**/*.d.ts

# 最小化されたファイル
node_modules/**/*.min.js

# lzma-native - ソースを除外してprebuildsのみ残す
node_modules/lzma-native/src/**
node_modules/lzma-native/deps/**
node_modules/lzma-native/binding.gyp
node_modules/lzma-native/liblzma-build.sh
node_modules/lzma-native/liblzma-config.sh

# 7zip-bin - ビルドスクリプトを除外
node_modules/7zip-bin/7x.sh
node_modules/7zip-bin/linux/x64/do-build.sh
node_modules/7zip-bin/linux/x64/build.sh

# その他の開発用ファイル
node_modules/**/bower.json
node_modules/**/component.json
node_modules/**/yarn.lock
node_modules/**/package-lock.json
node_modules/**/.editorconfig
node_modules/**/.prettierrc*
node_modules/**/*.d.ts

# binディレクトリ（実行可能ファイルは必要だがスクリプトは不要）
node_modules/**/bin/**
